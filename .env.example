# ============================================================================
# DigitallyDefined Clean Backend - Environment Template
# ============================================================================
# Copy to .env and fill in real values. NEVER commit real values.
#
# AI ROUTING: Vertex AI Gemini is the PRIMARY provider.
#   REQUIRED: VERTEX_PROJECT_ID, VERTEX_LOCATION, VERTEX_MODEL, GEMINI_API_KEY
#   OPTIONAL fallbacks: OPENROUTER_API_KEY, AGNES_API_KEY + AGNES_BASE_URL
#   OmniRoute is DISABLED (optional keys kept for reference only).
# ============================================================================

# ============================================================================
# DigitallyDefined Clean Backend — Environment Variables
# ============================================================================
# COMPLETE migration from digitallydefined-os-backend/.env + all related
# sources (.env.example, fastapi/.env.example, omniroute-linode.env,
# omniroute-backend-env.txt, dashboard/.env, online-local/.env).
#
# NEVER commit real values. This file is gitignored.
# ============================================================================

# ============================================================================
# CORE CONFIGURATION
# ============================================================================
NODE_ENV=<node-env>
PORT=3000
VERCEL_URL=
VERCEL_ENV=<vercel-env>

# ============================================================================
# AUTHENTICATION
# Shared API key — frontend sends x-api-key; backend verifies it.
# ============================================================================
DASHBOARD_API_KEY=<dashboard-api-key>

# ============================================================================
# SUPABASE
# ============================================================================
SUPABASE_URL=<supabase-url>
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_SERVICE_KEY=<supabase-service-key>

# ============================================================================
# AI PROVIDERS
# ============================================================================
# OmniRoute (PRIMARY AI gateway — running LOCALLY on port 20128)
OMNIROUTE_BASE_URL=<omniroute-base-url>
OMNIROUTE_API_KEY=<omniroute-api-key>
OMNIROUTE_MODEL=<omniroute-model>
OMNIROUTE_FALLBACK_MODELS=[]
OMNIROUTE_TIMEOUT_MS=60000
OMNIROUTE_MACHINE_ID=<omniroute-machine-id>
OMNIROUTE_WS_URL=<omniroute-ws-url>
OMNIROUTE_DASHBOARD_URL=<omniroute-dashboard-url>
OMNIROUTE_WS_BRIDGE_SECRET=
MACHINE_ID=<machine-id>

# Gemini (optional fallback — only used when GEMINI_API_KEY is non-empty)
GEMINI_API_KEY=<gemini-api-key>
GOOGLE_API_KEY=<google-api-key>
GEMINI_BASE_URL=<gemini-base-url>
GEMINI_MODEL=<gemini-model>

# Vertex AI Gemini (PRIMARY AI provider)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=<vertex-location>
VERTEX_MODEL=<vertex-model>

# OpenRouter (optional fallback 1)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=<openrouter-model>

# Agnes (optional fallback 2)
AGNES_API_KEY=
AGNES_BASE_URL=
AGNES_MODEL=<agnes-model>

# Cheaper Inference (optional)
CHEAPER_INFERENCE_API_KEY=
CHEAPER_INFERENCE_BASE_URL=
CHEAPER_INFERENCE_MODEL=

# FastAPI microservice layer (product-generator / niche / domain / affiliate /
# rank-rent / blueprint / roadmap / trends) reached via /fastapi/* proxy.
FASTAPI_BASE_URL=<fastapi-base-url>
FASTAPI_API_KEY=<fastapi-api-key>

# ============================================================================
# NOTION
# ============================================================================
NOTION_API_KEY=<notion-api-key>
NOTION_TOKEN=<notion-token>
NOTION_SECRET=<notion-secret>
NOTION_LIVE_MODE=false
NOTION_BASE_URL=<notion-base-url>
NOTION_VERSION=<notion-version>
NOTION_SYNC_URL=
NOTION_PHASE21_LIVE_APPROVAL=false

# Database IDs
NOTION_IDEAS_DB_ID=<notion-ideas-db-id>
NOTION_CONTENT_DB_ID=<notion-content-db-id>
NOTION_AUTOMATIONS_DB_ID=<notion-automations-db-id>
NOTION_COMMAND_CENTER_DB_ID=<notion-command-center-db-id>
NOTION_DIGITAL_ASSETS_DB_ID=<notion-digital-assets-db-id>
NOTION_PUBLISHING_QUEUE_DB_ID=
NOTION_CONTENT_APPROVALS_DB_ID=
NOTION_BUYER_SIGNALS_DB_ID=
NOTION_AI_CONTENT_DRAFTS_DB_ID=
NOTION_LEADS_DB_ID=
NOTION_QUIZ_RESULTS_DB_ID=
NOTION_CONTACT_MESSAGES_DB_ID=
NOTION_WEBHOOK_SECRET=
NOTION_SYNC_WINDOW_MIN=420

# Secondary Notion target DBs (used by specific sync jobs)
TARGET_DB_ID=
AREAS_DB_ID=
PROJECTS_DB_ID=

# ============================================================================
# FACEBOOK / META
# ============================================================================
META_APP_ID=
META_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=<facebook-access-token>
FACEBOOK_GROUP_ID=1050373128164124
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ============================================================================
# INSTAGRAM
# ============================================================================
INSTAGRAM_USER_ID=<instagram-user-id>
INSTAGRAM_USERNAME=<instagram-username>
INSTAGRAM_BUSINESS_ID=17841458308409190
INSTAGRAM_BUSINESS_ACCOUNT_ID=17841458308409190
INSTAGRAM_ACCOUNT_ID=17841458308409190
INSTAGRAM_ACCESS_TOKEN=<instagram-access-token>

# ============================================================================
# THREADS
# ============================================================================
THREADS_APP_ID=4204436683151598
THREADS_APP_SECRET=<threads-app-secret>
THREADS_USER_ID=26460916806911110
THREADS_ACCESS_TOKEN=<threads-access-token>

# ============================================================================
# OTHER SOCIAL PLATFORMS
# ============================================================================
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_ORGANIZATION_ID=
PINTEREST_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ============================================================================
# BREVO (EMAIL MARKETING)
# ============================================================================
BREVO_API_KEY=<brevo-api-key>
BREVO_LIST_ID=2
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=<brevo-from-name>

# ============================================================================
# GOOGLE SHEETS / OAUTH
# ============================================================================
SHEETS_WEBHOOK_URL=<sheets-webhook-url>
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REFRESH_TOKEN=

# ============================================================================
# THIRD-PARTY SERVICES
# ============================================================================
GUMROAD_API_KEY=<gumroad-api-key>
EXA_API_KEY=<exa-api-key>
FIRECRAWL_API_KEY=<firecrawl-api-key>

# ============================================================================
# TELEGRAM
# ============================================================================
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_ALLOWED_USERS=7630632663
TELEGRAM_CHAT_ID=

# ============================================================================
# ANTIGRAVITY MCP (Notion Architect)
# ============================================================================
ANTIGRAVITY_URL=<antigravity-url>
ANTIGRAVITY_API_KEY=<antigravity-api-key>
ANTIGRAVITY_NOTION_TOKEN=<antigravity-notion-token>
ANTIGRAVITY_WORKSPACE_ID=

# ============================================================================
# HERMES MCP GATEWAY
# ============================================================================
HERMES_GATEWAY_URL=<hermes-gateway-url>
BACKEND_HERMES_URL=<backend-hermes-url>
HERMES_MCP_PORT=8000

# ============================================================================
# LINODE / LOCAL INTERNAL (Backend Only — never exposed to the browser)
# ============================================================================
MAIN_BASE_URL=<main-base-url>
LINODE_CLI_URL=<linode-cli-url>

# ============================================================================
# SECURITY KEYS (Backend Only)
# ============================================================================
JWT_SECRET=<jwt-secret>
API_KEY_SECRET=<api-key-secret>
STORAGE_ENCRYPTION_KEY=<storage-encryption-key>
STORAGE_ENCRYPTION_KEY_VERSION=<storage-encryption-key-version>
ENCRYPTION_KEY=<encryption-key>

# ============================================================================
# MONITORING
# ============================================================================
AGENTOPS_API_KEY=<agentops-api-key>
MONITORING_API_KEY=<monitoring-api-key>

# ============================================================================
# CRON / AUTOMATION FLAGS
# ============================================================================
CRON_LOG_PATH=
CRON_DEDUP_STORE_PATH=
CRON_LIVE_POSTS=false
LIVE_CRON_POSTS=false

# ============================================================================
# SELLABLE (Product Onboarding)
# ============================================================================
SELLABLE_DRY_RUN=true
SELLABLE_LIVE_APPROVAL=false
SELLABLE_FROM_EMAIL=
SELLABLE_FROM_NAME=<sellable-from-name>
SELLABLE_BREVO_LIST_ID=2
SELLABLE_ONBOARDING_DAYS=7

# ============================================================================
# PUTER (optional workspace)
# ============================================================================
PUTER_ENABLED=false
PUTER_API_KEY=
OUTPUT_DIR=<output-dir>
